# ========== Production (Supabase) Configuration ==========
# This default points at the Supabase Postgres instance for PRODUCTION/DEFAULT usage.
export POSTGRES_URL="postgresql://postgres:[YOUR_SECRET_PASSWORD]@db.xihtrwadyqfimillpxff.supabase.co:5432/postgres?sslmode=require"
export POSTGRES_USER="postgres"
export POSTGRES_PASSWORD="[YOUR_SECRET_PASSWORD]"
export POSTGRES_DB="postgres"
export POSTGRES_PORT="5432"

# Replace [YOUR_SECRET_PASSWORD] with your Supabase project's DB password (from Supabase dashboard > Database > Connection info).
# Developers: Copy these export lines into any backend `.env` file as appropriate!

# ========== Local Development (Override) ==========
# For offline/local development, COMMENT the above and UNCOMMENT these lines:
# export POSTGRES_URL="postgresql://appuser:dbuser123@localhost:5000/myapp"
# export POSTGRES_USER="appuser"
# export POSTGRES_PASSWORD="dbuser123"
# export POSTGRES_DB="myapp"
# export POSTGRES_PORT="5000"

# USAGE:
# - To switch between dev/prod locally: edit and `source finance_db/db_visualizer/postgres.env` before running your backend or viewer
# - Many backend frameworks (e.g. FastAPI, Django, Flask, etc.) read POSTGRES_URL or DATABASE_URL from .env automatically

# SECURITY: Do NOT commit real Supabase passwords to the repo, use [YOUR_SECRET_PASSWORD] as placeholder and share real creds securely.
